    "errorCodes": [],
    "criticalCodes": []
  },
  "findingPolicy": {
    "schema": "wellmanifest.dsl/findings/v1",
    "requiredProducers": ["autogrammar.intract.governance-check"],
    "securityProducers": ["autogrammar.intract.governance-check"],
    "blockingSeverities": ["critical"],
    "requireEvaluable": true,
    "blockUnresolvedSecurity": true
