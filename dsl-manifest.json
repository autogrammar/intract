  "publicationPolicy": {
    "declaredTier": "review",
    "deterministic": true,
    "independentReview": true,
    "externalAuthority": false,
    "runtimeIsolation": false
  },
  "conformance": {
    "levels": ["manifest", "contract"],
    "commands": ["python -m pytest tests/"],
